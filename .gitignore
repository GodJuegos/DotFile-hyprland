# ~/.config/.gitignore (Versión 1.0.0)
# Propósito: Whitelist de Git que ignora todo en ~/.config por defecto (evita subir navegadores, sesiones o datos privados) y solo permite las carpetas del proyecto.
*

# Archivos base del repositorio
!.gitignore
!LICENSE
!README.md
!install.sh
!packages.txt
!antigravity-chats-backup.zip

# Configuraciones de Hyprland y entorno
!hypr/
!hypr/**
!kitty/
!kitty/**
!ski/
!ski/**
!wofi/
!wofi/**
!waybar/
!waybar/**
!quickshell/
!quickshell/**
!wireplumber/
!wireplumber/**
!fastfetch/
!fastfetch/**
!cava/
!cava/**
!matugen/
!matugen/**
!gtk-3.0/
!gtk-3.0/**
!qt6ct/
!qt6ct/**
