{
  "version": "1.0.0",
  "bar": {
    "position": "top",
    "thickness": 42,
    "margin": 8,
    "spacing": 10,
    "showWorkspaces": true,
    "showFocus": true,
    "showTimeDate": true,
    "showNetwork": true,
    "showAudio": true,
    "showTray": true,
    "showBattery": false
  },
  "audio": {
    "preferredRoute": "speakers",
    "disableAutoMute": true
  },
  "glass": {
    "opacity": 0.24,
    "borderOpacity": 0.48,
    "highlightOpacity": 0.65,
    "cornerRadius": 18
  }
}
